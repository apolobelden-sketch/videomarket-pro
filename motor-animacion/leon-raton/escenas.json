{"escenas": [
 {"img":"s/t0.5.jpg","dur":4.5,"de":[0.5,0.42,1.3],"a":[0.5,0.45,1.08],"rayos":0.5,"chispas":0.9,"titulo":["EL LEÓN","Y EL RATÓN"],"texto_desde":0.4},
 {"img":"s/t0.5.jpg","dur":7,"de":[0.5,0.55,1.05],"a":[0.45,0.56,1.32],"respira":0.008,"rayos":0.45,"chispas":0.6,"texto":"Un gran león dormía tranquilo bajo la sombra de un árbol.","y_texto":1560},
 {"img":"s/t0.5.jpg","dur":6.5,"de":[0.3,0.68,1.7],"a":[0.24,0.72,2.0],"chispas":0.5,"texto":"De pronto, un ratoncito curioso le pasó por la nariz… ¡y lo despertó!","y_texto":420},
 {"img":"s/t14.jpg","dur":7,"de":[0.5,0.5,1.02],"a":[0.62,0.6,1.35],"rayos":0.3,"chispas":0.4,"texto":"«¡Por favor, déjame ir! Algún día yo te ayudaré», le suplicó el ratón.","y_texto":1580},
 {"img":"s/t8.5.jpg","dur":6,"de":[0.5,0.45,1.2],"a":[0.5,0.5,1.04],"chispas":0.4,"texto":"El león soltó una carcajada… pero lo dejó ir.","y_texto":1600},
 {"img":"s/t18.jpg","dur":7.5,"de":[0.5,0.28,1.45],"a":[0.5,0.72,1.45],"rayos":0.35,"chispas":0.3,"texto":"Días después, el león cayó en la red de unos cazadores.","y_texto":1560},
 {"img":"s/t24.jpg","dur":7,"de":[0.5,0.6,1.05],"a":[0.5,0.78,1.3],"tiembla":3,"chispas":0.5,"texto":"El ratoncito mordió la cuerda una y otra vez… ¡hasta romperla!","y_texto":380},
 {"img":"s/t28.jpg","dur":6.5,"de":[0.42,0.55,1.18],"a":[0.58,0.55,1.18],"rayos":0.5,"chispas":0.7,"texto":"«Gracias, amigo», dijo el león. Desde ese día fueron inseparables.","y_texto":1620},
 {"img":"s/t34.jpg","dur":8.5,"de":[0.5,0.55,1.35],"a":[0.5,0.5,1.0],"rayos":0.6,"chispas":1.0,"titulo":["MORALEJA"],"texto":"Nadie es tan pequeño que no pueda ayudar.","tam":70,"color":[255,226,120],"y_texto":620,"marca":"Ediciones Guizar","texto_desde":0.8}
]}
